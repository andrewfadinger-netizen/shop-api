# Скопируйте в .env и при необходимости измените значения
PORT=3000

# Локальный MongoDB (служба MongoDB Server на Windows)
MONGODB_URI=mongodb://127.0.0.1:27017/shop_db

# Или MongoDB Atlas (подставьте свои логин, пароль и адрес кластера):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shop_db?retryWrites=true&w=majority

NODE_ENV=development
