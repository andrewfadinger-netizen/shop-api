{
  "name": "shop-api",
  "version": "1.0.0",
  "description": "REST API интернет-магазина электроники: Express + Mongoose + MongoDB (учебный проект по проектированию БД)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "express",
    "mongoose",
    "mongodb",
    "rest-api",
    "crud"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.12.1",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
